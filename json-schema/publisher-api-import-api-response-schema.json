{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-schema/publisher-api-import-api-response-schema.json",
  "title": "Import API Response",
  "description": "ImportAPIResponse schema from WSO2 API Manager",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "UUID of the imported API\n",
      "example": "01234567-0123-0123-0123-012345678901"
    },
    "revision": {
      "type": "string",
      "description": "Revision of the imported API\n",
      "example": 1
    }
  }
}