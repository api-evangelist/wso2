{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-structure/publisher-api-advertise-info-structure.json",
  "name": "API Advertise info object with advertise details",
  "description": "AdvertiseInfo schema from WSO2 API Manager",
  "type": "object",
  "properties": {
    "advertised": {
      "type": "boolean",
      "example": true
    },
    "apiExternalProductionEndpoint": {
      "type": "string",
      "example": "https://localhost:9443/devportal"
    },
    "apiExternalSandboxEndpoint": {
      "type": "string",
      "example": "https://localhost:9443/devportal"
    },
    "originalDevPortalUrl": {
      "type": "string",
      "example": "https://localhost:9443/devportal"
    },
    "apiOwner": {
      "type": "string",
      "example": "admin"
    },
    "vendor": {
      "type": "string",
      "default": "WSO2",
      "enum": [
        "WSO2",
        "AWS"
      ]
    }
  }
}