{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-structure/publisher-api-api-key-structure.json",
  "name": "API Key details to invoke APIs",
  "description": "APIKey schema from WSO2 API Manager",
  "type": "object",
  "properties": {
    "apikey": {
      "type": "string",
      "description": "API Key",
      "example": "eyJoZWxsbyI6IndvcmxkIn0=.eyJ3c28yIjoiYXBpbSJ9.eyJ3c28yIjoic2lnbmF0dXJlIn0="
    },
    "validityTime": {
      "type": "int32",
      "example": 3600
    }
  }
}