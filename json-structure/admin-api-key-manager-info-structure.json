{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-structure/admin-api-key-manager-info-structure.json",
  "name": "Key Manager Info",
  "description": "KeyManagerInfo schema from WSO2 API Manager",
  "required": [
    "name",
    "type"
  ],
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "example": "01234567-0123-0123-0123-012345678901"
    },
    "name": {
      "type": "string",
      "example": "WSO2 IS"
    },
    "type": {
      "type": "string",
      "example": "IS"
    },
    "description": {
      "type": "string",
      "example": "This is a key manager for Developers"
    },
    "enabled": {
      "type": "boolean",
      "example": true
    },
    "isGlobal": {
      "type": "boolean",
      "example": true
    },
    "isUsed": {
      "type": "boolean",
      "example": true
    },
    "tokenType": {
      "type": "string",
      "description": "The type of the tokens to be used (exchanged or without exchanged). Accepted values are EXCHANGED, DIRECT and BOTH.",
      "example": "EXCHANGED",
      "default": "DIRECT",
      "enum": [
        "EXCHANGED",
        "DIRECT",
        "BOTH"
      ]
    }
  }
}