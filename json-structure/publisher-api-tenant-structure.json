{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-structure/publisher-api-tenant-structure.json",
  "name": "Tenant",
  "description": "Tenant schema from WSO2 API Manager",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "description": "tenant domain",
      "example": "wso2.com"
    },
    "status": {
      "type": "string",
      "description": "current status of the tenant active/inactive",
      "example": "active"
    }
  }
}