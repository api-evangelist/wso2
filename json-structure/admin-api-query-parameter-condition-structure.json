{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-structure/admin-api-query-parameter-condition-structure.json",
  "name": "Query parameter based throttling condition",
  "description": "QueryParameterCondition schema from WSO2 API Manager",
  "required": [
    "parameterName",
    "parameterValue"
  ],
  "type": "object",
  "properties": {
    "parameterName": {
      "type": "string",
      "description": "Name of the query parameter"
    },
    "parameterValue": {
      "type": "string",
      "description": "Value of the query parameter to be matched"
    }
  }
}