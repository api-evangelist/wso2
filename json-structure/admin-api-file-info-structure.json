{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-structure/admin-api-file-info-structure.json",
  "name": "File Information including meta data",
  "description": "FileInfo schema from WSO2 API Manager",
  "type": "object",
  "properties": {
    "relativePath": {
      "type": "string",
      "description": "relative location of the file (excluding the base context and host of the Admin API)",
      "example": "api-categories/01234567-0123-0123-0123-012345678901/thumbnail"
    },
    "mediaType": {
      "type": "string",
      "description": "media-type of the file",
      "example": "image/jpeg"
    }
  }
}