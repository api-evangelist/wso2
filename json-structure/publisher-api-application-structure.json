{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-structure/publisher-api-application-structure.json",
  "name": "Application",
  "description": "Application schema from WSO2 API Manager",
  "required": [
    "name",
    "throttlingTier"
  ],
  "type": "object",
  "properties": {
    "applicationId": {
      "type": "string",
      "example": "01234567-0123-0123-0123-012345678901"
    },
    "name": {
      "type": "string",
      "example": "CalculatorApp"
    },
    "subscriber": {
      "type": "string",
      "example": "admin"
    },
    "throttlingTier": {
      "type": "string",
      "example": "Unlimited"
    },
    "description": {
      "type": "string",
      "example": "Sample calculator application"
    },
    "groupId": {
      "type": "string",
      "example": ""
    }
  }
}