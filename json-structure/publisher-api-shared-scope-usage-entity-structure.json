{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-structure/publisher-api-shared-scope-usage-entity-structure.json",
  "name": "Entity using shared scope",
  "description": "SharedScopeUsageEntity schema from WSO2 API Manager",
  "required": [
    "context",
    "name",
    "version"
  ],
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "example": "CalculatorAPI"
    },
    "context": {
      "type": "string",
      "example": "CalculatorAPI"
    },
    "version": {
      "type": "string",
      "example": "1.0.0"
    },
    "provider": {
      "type": "string",
      "description": "If the provider value is not given user invoking the api will be used as the provider.\n",
      "example": "admin"
    },
    "revisionId": {
      "type": "string",
      "example": "Revision 1"
    },
    "type": {
      "type": "string",
      "description": "Entity type.\n",
      "example": "MCP"
    },
    "usedResourceList": {
      "type": "array",
      "description": "Resource list which have used the shared scope.\n",
      "items": {
        "$ref": "#/components/schemas/SharedScopeUsedResourceInfo"
      }
    }
  }
}