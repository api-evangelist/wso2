{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-structure/publisher-api-api-endpoint-list-structure.json",
  "name": "Endpoints List",
  "description": "APIEndpointList schema from WSO2 API Manager",
  "type": "object",
  "properties": {
    "count": {
      "type": "int32",
      "description": "Number of Endpoints returned.\n",
      "example": 1
    },
    "list": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/APIEndpoint"
      }
    },
    "pagination": {
      "$ref": "#/components/schemas/Pagination"
    }
  }
}