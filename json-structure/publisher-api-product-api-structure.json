{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-structure/publisher-api-product-api-structure.json",
  "name": "ProductAPI",
  "description": "ProductAPI schema from WSO2 API Manager",
  "required": [
    "apiId"
  ],
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "example": "PizzaShackAPI"
    },
    "apiId": {
      "type": "string",
      "example": "01234567-0123-0123-0123-012345678901"
    },
    "version": {
      "type": "string",
      "example": "1.0"
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/APIOperations"
      }
    }
  }
}