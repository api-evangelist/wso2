{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-structure/admin-api-model-provider-structure.json",
  "name": "Model Provider",
  "description": "ModelProvider schema from WSO2 API Manager",
  "type": "object",
  "required": [
    "name",
    "models"
  ],
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "type": "string",
        "example": "gpt-4o"
      }
    },
    "name": {
      "type": "string",
      "example": "OpenAI"
    }
  }
}