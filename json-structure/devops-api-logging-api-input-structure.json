{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-structure/devops-api-logging-api-input-structure.json",
  "name": "API Info object with log details",
  "description": "LoggingApiInput schema from WSO2 API Manager",
  "type": "object",
  "required": [
    "logLevel"
  ],
  "properties": {
    "logLevel": {
      "type": "string",
      "example": "FULL"
    },
    "resourceMethod": {
      "type": "string",
      "example": "GET"
    },
    "resourcePath": {
      "type": "string",
      "example": "/v1.0.0/pizza"
    }
  }
}