{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-structure/publisher-api-application-info-structure.json",
  "name": "Application info object with basic application details",
  "description": "ApplicationInfo schema from WSO2 API Manager",
  "type": "object",
  "properties": {
    "applicationId": {
      "type": "string",
      "example": "01234567-0123-0123-0123-012345678901"
    },
    "name": {
      "type": "string",
      "example": "CalculatorApp"
    },
    "subscriber": {
      "type": "string",
      "example": "admin"
    },
    "description": {
      "type": "string",
      "example": "Sample calculator application"
    },
    "subscriptionCount": {
      "type": "int32"
    }
  }
}