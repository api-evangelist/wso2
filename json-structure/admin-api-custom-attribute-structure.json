{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wso2/refs/heads/main/json-structure/admin-api-custom-attribute-structure.json",
  "name": "Name-Value pair",
  "description": "CustomAttribute schema from WSO2 API Manager",
  "required": [
    "name",
    "value"
  ],
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the custom attribute",
      "example": "customAttr1"
    },
    "value": {
      "type": "string",
      "description": "Value of the custom attribute",
      "example": "value1"
    }
  }
}