{
  "opencollection": "1.0.0",
  "info": {
    "name": "WSO2 API Manager - Admin Advanced Policy (Collection) Advanced Policy (Collection) Policy Adherence API",
    "version": "v4"
  },
  "items": [
    {
      "info": {
        "name": "Policy Adherence",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve adherence status for all policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/policy-adherence",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum size of resource array to return.\n"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Starting point within the complete list of items qualified.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve adherence status of all governance policies within the organization."
        },
        {
          "info": {
            "name": "Retrieves the summary of adherence for all policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/policy-adherence/summary",
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves the summary of adherence for all governance policies within the organization."
        },
        {
          "info": {
            "name": "Retrieve adherence details for a specific policy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/policy-adherence/:policyId",
            "params": [
              {
                "name": "policyId",
                "value": "",
                "type": "path",
                "description": "**UUID** of the Policy.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve adherence details associated with a specific governance policy within the organization using its unique ID. The list of artifacts under the policy will only contain the artifacts visible to user"
        }
      ]
    }
  ],
  "bundled": true
}