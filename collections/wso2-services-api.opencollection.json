{
  "opencollection": "1.0.0",
  "info": {
    "name": "WSO2 API Manager - Admin Advanced Policy (Collection) Advanced Policy (Collection) Services API",
    "version": "v4"
  },
  "items": [
    {
      "info": {
        "name": "Services",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve/search services",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/services",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter services by the name of the service\n"
              },
              {
                "name": "version",
                "value": "",
                "type": "query",
                "description": "Filter services by version of the service\n"
              },
              {
                "name": "definitionType",
                "value": "",
                "type": "query",
                "description": "Filter services by definitionType\n"
              },
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Comma seperated keys of the services to check\n"
              },
              {
                "name": "shrink",
                "value": "",
                "type": "query",
                "description": "If this set to true, a minimal set of fields will be provided for each service including the md5\n"
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortOrder",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum limit of items to return.\n"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Starting point within the complete list of items qualified.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve or search services in the service catalog of the user's organization or tenant. Search is supported\nusing the name, version, definitionType and key of the service.\nSearch based on the definition type and key of the service will always be an exact search. If you want to\nexecute an exact search for either name or version the parameter should be given inside double quotation.\n"
        },
        {
          "info": {
            "name": "Add a new service to Service Catalog",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apis.wso2.com/api/am/admin/v4/services",
            "body": {
              "type": "multipart-form",
              "data": []
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Add a new service to the service catalog of the user's organization (or tenant)\nby specifying the details of the service along with its definition. \n"
        },
        {
          "info": {
            "name": "Get details of a service",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/services/:serviceId",
            "params": [
              {
                "name": "serviceId",
                "value": "",
                "type": "path",
                "description": "uuid of the service"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get details of a service using the id of the service.\n"
        },
        {
          "info": {
            "name": "Update a service",
            "type": "http"
