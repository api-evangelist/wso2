          "http": {
            "method": "DELETE",
            "url": "https://apis.wso2.com/api/am/admin/v4/services/:serviceId",
            "params": [
              {
                "name": "serviceId",
                "value": "",
                "type": "path",
                "description": "uuid of the service"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Delete a service by providing the service id\n"
        },
        {
          "info": {
            "name": "Retrieve a service definition",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/services/:serviceId/definition",
            "params": [
              {
                "name": "serviceId",
                "value": "",
                "type": "path",
                "description": "uuid of the service"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve the definition of a service identified by the service id.\n"
        },
        {
          "info": {
            "name": "Retrieve the API Info that use the given service",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/services/:serviceId/usage",
            "params": [
              {
                "name": "serviceId",
                "value": "",
