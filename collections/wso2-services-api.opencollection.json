          "http": {
            "method": "PUT",
            "url": "https://apis.wso2.com/api/am/admin/v4/services/:serviceId",
            "params": [
              {
                "name": "serviceId",
                "value": "",
                "type": "path",
                "description": "uuid of the service"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": []
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Update a service's details and definition\n"
        },
        {
          "info": {
            "name": "Delete a service",
            "type": "http"
