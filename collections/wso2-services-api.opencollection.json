                "description": "Whether to overwrite if there is any existing service with the same name and version.\n"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "verifier",
