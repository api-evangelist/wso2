{
  "opencollection": "1.0.0",
  "info": {
    "name": "WSO2 API Manager - Admin Advanced Policy (Collection) Advanced Policy (Collection) Bot Detection Alert Subscriptions API",
    "version": "v4"
  },
  "items": [
    {
      "info": {
        "name": "Bot Detection Alert Subscriptions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Subscriptions for Bot Detection\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/alert-subscriptions/bot-detection",
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get the list of subscriptions which are subscribed to receive email alerts for bot detection\n"
        },
        {
          "info": {
            "name": "Subscribe for Bot Detection Alerts",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apis.wso2.com/api/am/admin/v4/alert-subscriptions/bot-detection",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Register a subscription for bot detection alerts\n"
        },
        {
          "info": {
            "name": "Unsubscribe from bot detection alerts.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://apis.wso2.com/api/am/admin/v4/alert-subscriptions/bot-detection/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "uuid of the subscription"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Delete a Bot Detection Alert Subscription\n"
        }
      ]
    }
  ],
  "bundled": true
}