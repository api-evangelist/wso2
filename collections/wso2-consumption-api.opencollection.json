{
  "opencollection": "1.0.0",
  "info": {
    "name": "WSO2 API Manager - Admin Advanced Policy (Collection) Advanced Policy (Collection) Consumption API",
    "version": "v4"
  },
  "items": [
    {
      "info": {
        "name": "Consumption",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Export API Consumption Data\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/export-consumption",
            "params": [
              {
                "name": "fromDate",
                "value": "",
                "type": "query",
                "description": "Start date of the export range (inclusive). Format: YYYY-MM-DD.\n"
              },
              {
                "name": "toDate",
                "value": "",
                "type": "query",
                "description": "End date of the export range (inclusive). Format: YYYY-MM-DD.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation provides a ZIP archive containing API consumption/usage data\nfor a given date range.\n"
        }
      ]
    }
  ],
  "bundled": true
}