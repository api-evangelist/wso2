{
  "opencollection": "1.0.0",
  "info": {
    "name": "WSO2 API Manager - Admin Advanced Policy (Collection) Advanced Policy (Collection) Alert Subscriptions API",
    "version": "v4"
  },
  "items": [
    {
      "info": {
        "name": "Alert Subscriptions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Subscribed Alert Types\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/alert-subscriptions",
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation is used to get the list of subscribed alert types by the user.\n"
        },
        {
          "info": {
            "name": "Subscribe to an Admin Alert\n",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://apis.wso2.com/api/am/admin/v4/alert-subscriptions",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation is used to subscribe to admin alerts\n"
        },
        {
          "info": {
            "name": "Unsubscribe User from all Admin Alerts\n",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://apis.wso2.com/api/am/admin/v4/alert-subscriptions",
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation is used to unsubscribe the respective user from all the admin alert types.\n"
        }
      ]
    }
  ],
  "bundled": true
}