{
  "opencollection": "1.0.0",
  "info": {
    "name": "WSO2 API Manager - Admin Advanced Policy (Collection) Advanced Policy (Collection) System Scopes API",
    "version": "v4"
  },
  "items": [
    {
      "info": {
        "name": "System Scopes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Scopes for a Particular User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/system-scopes/:scopeName",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "query"
              },
              {
                "name": "scopeName",
                "value": "",
                "type": "path",
                "description": "Base64 URL encoded value of the scope name to be validated\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation will return the scope list of particular user\nIn order to get it, we need to pass the userId as a query parameter\n"
        },
        {
          "info": {
            "name": "Get Role Scope Mappings\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/system-scopes",
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation is used to get the list of role scope mapping from tenant-conf for the apim admin dashboard\n"
        },
        {
          "info": {
            "name": "Update Roles For Scope\n",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://apis.wso2.com/api/am/admin/v4/system-scopes",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation is used to update the roles for all scopes\n"
        },
        {
          "info": {
            "name": "Retrieve Role Alias Mappings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/system-scopes/role-aliases",
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation can be used to retreive role alias mapping\n"
        },
        {
          "info": {
            "name": "Add a New Role Alias",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://apis.wso2.com/api/am/admin/v4/system-scopes/role-aliases",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation can be used to add a new role alias mapping for system scope roles\n"
        }
      ]
    }
  ],
  "bundled": true
}