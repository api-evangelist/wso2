{
  "opencollection": "1.0.0",
  "info": {
    "name": "WSO2 API Manager - Admin Advanced Policy (Collection) Advanced Policy (Collection) GraphQL Policies API",
    "version": "v4"
  },
  "items": [
    {
      "info": {
        "name": "GraphQL Policies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the Complexity Related Details of an API",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/apis/:apiId/graphql-policies/complexity",
            "params": [
              {
                "name": "apiId",
                "value": "",
                "type": "path",
                "description": "**API ID** consisting of the **UUID** of the API.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation can be used to retrieve complexity related details belonging to an API by providing the API id.\n"
        },
        {
          "info": {
            "name": "Retrieve Types and Fields of a GraphQL Schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/apis/:apiId/graphql-policies/complexity/types",
            "params": [
              {
                "name": "apiId",
                "value": "",
                "type": "path",
                "description": "**API ID** consisting of the **UUID** of the API.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation can be used to retrieve all types and fields of the GraphQL Schema by providing the API id.\n"
        }
      ]
    }
  ],
  "bundled": true
}