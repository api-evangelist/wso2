          "info": {
            "name": "Get the details of an Application\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/applications/:applicationId",
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application UUID\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation can be used to get the details of an application by specifying its id.\n"
        },
