      "items": [
        {
          "info": {
            "name": "Get All Subscriptions\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/subscriptions",
            "headers": [
              {
                "name": "X-WSO2-Tenant",
                "value": ""
              },
              {
                "name": "If-None-Match",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "apiId",
                "value": "",
                "type": "query",
                "description": "**API ID** consisting of the **UUID** of the API.\n"
              },
              {
                "name": "applicationId",
                "value": "",
                "type": "query",
                "description": "**Application Identifier** consisting of the UUID of the Application.\n"
              },
              {
                "name": "groupId",
                "value": "",
                "type": "query",
                "description": "Application Group Id\n"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Starting point within the complete list of items qualified.\n"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum size of resource array to return.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation can be used to retrieve a list of subscriptions of the user associated with the provided access token. This operation is capable of\n\n1. Retrieving applications which are subscribed to a specific API.\n`GET https://localhost:9443/api/am/devportal/v3/subscriptions?apiId=c43a325c-260b-4302-81cb-768eafaa3aed`\n\n2. Retrieving APIs which are subscribed by a specific application.\n`GET https://localhost:9443/api/am/devportal/v3/subscriptions?applicationId=c43a325c-260b-4302-81cb-768eafaa3ae"
        },
