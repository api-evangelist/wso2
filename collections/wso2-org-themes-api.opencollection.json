{
  "opencollection": "1.0.0",
  "info": {
    "name": "WSO2 API Manager - Admin Advanced Policy (Collection) Advanced Policy (Collection) Org Themes API",
    "version": "v4"
  },
  "items": [
    {
      "info": {
        "name": "Org Themes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve UUIDs of org-theme contents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/org-themes",
            "params": [
              {
                "name": "publish",
                "value": "",
                "type": "query",
                "description": "Filter themes based on published status"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns the UUIDs of org-theme contents and their publish status."
        },
        {
          "info": {
            "name": "Import org theme",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apis.wso2.com/api/am/admin/v4/org-themes",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Imports a drafted zip of an org theme to APIM."
        },
        {
          "info": {
            "name": "Retrieve org theme as zip",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/org-themes/:id/content",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns the org theme as a zip file for the given ID."
        },
        {
          "info": {
            "name": "Delete an org theme",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://apis.wso2.com/api/am/admin/v4/org-themes/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Deletes the org theme for the given ID."
        },
        {
          "info": {
            "name": "Update publish status of an org theme",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apis.wso2.com/api/am/admin/v4/org-themes/:id/status",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Publishes or unpublishes an org theme to the dev portal."
        }
      ]
    }
  ],
  "bundled": true
}