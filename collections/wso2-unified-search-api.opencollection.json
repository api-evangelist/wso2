{
  "opencollection": "1.0.0",
  "info": {
    "name": "WSO2 API Manager - Admin Advanced Policy (Collection) Advanced Policy (Collection) Unified Search API",
    "version": "v4"
  },
  "items": [
    {
      "info": {
        "name": "Unified Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve/Search Throttling Policies\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/throttling/policies/search",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "**Search**.\nYou can search by providing a keyword. Allowed to search by type and name only.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation provides you a list of available Throttling Policies qualifying the given keyword match.\n"
        },
        {
          "info": {
            "name": "Retrieve/Search APIs and API Documents by Content\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/search",
            "headers": [
              {
                "name": "X-WSO2-Tenant",
                "value": ""
              },
              {
                "name": "If-None-Match",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum size of resource array to return.\n"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Starting point within the complete list of items qualified.\n"
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "**Search**.\n\nYou can search by using providing the search term in the query parameters.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation provides you a list of available APIs and API Documents qualifying the given keyword match.\n"
        }
      ]
    }
  ],
  "bundled": true
}