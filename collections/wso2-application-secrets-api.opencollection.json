{
  "opencollection": "1.0.0",
  "info": {
    "name": "WSO2 API Manager - Admin Advanced Policy (Collection) Advanced Policy (Collection) Application Secrets API",
    "version": "v4"
  },
  "items": [
    {
      "info": {
        "name": "Application Secrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate a New Consumer Secret\n",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apis.wso2.com/api/am/admin/v4/applications/:applicationId/oauth-keys/:keyMappingId/generate-secret",
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application Identifier consisting of the UUID of the Application.\n"
              },
              {
                "name": "keyMappingId",
                "value": "",
                "type": "path",
                "description": "OAuth Key Identifier consisting of the UUID of the Oauth Key Mapping.\n"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation can be used to generate a new consumer secret for an application for the given key type\n"
        },
        {
          "info": {
            "name": "Retrieve Consumer Secrets\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/applications/:applicationId/oauth-keys/:keyMappingId/secrets",
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application Identifier consisting of the UUID of the Application.\n"
              },
              {
                "name": "keyMappingId",
                "value": "",
                "type": "path",
                "description": "OAuth Key Identifier consisting of the UUID of the Oauth Key Mapping.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation can be used to retrieve consumer secrets of an application for the given key type\n"
        },
        {
          "info": {
            "name": "Revoke a Consumer Secret\n",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apis.wso2.com/api/am/admin/v4/applications/:applicationId/oauth-keys/:keyMappingId/revoke-secret",
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application Identifier consisting of the UUID of the Application.\n"
              },
              {
                "name": "keyMappingId",
                "value": "",
                "type": "path",
                "description": "OAuth Key Identifier consisting of the UUID of the Oauth Key Mapping.\n"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation can be used to revoke a consumer secret for an application for the give key type\n"
        }
      ]
    }
  ],
  "bundled": true
}