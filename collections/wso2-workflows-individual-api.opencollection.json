  "items": [
    {
      "info": {
        "name": "Workflows (Individual)",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Pending Workflow Details by External Workflow Reference\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/workflows/:externalWorkflowRef",
            "params": [
              {
                "name": "externalWorkflowRef",
                "value": "",
                "type": "path",
                "description": "from the externel workflow reference we decide what is the the pending request that the are requesting.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Using this operation, you can retrieve complete details of a pending workflow request that either belongs to application creation, application subscription, application registration, api state change, user self sign up.. You need to provide the External_Workflow_Reference of the workflow Request to retrive it.\n"
        },
        {
          "info": {
            "name": "Update Workflow Status",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apis.wso2.com/api/am/admin/v4/workflows/update-workflow-status",
            "params": [
              {
                "name": "workflowReferenceId",
                "value": "",
                "type": "query",
                "description": "Workflow reference id\n"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This operation can be used to approve or reject a workflow task.\n"
        }
      ]
    }
  ],
  "bundled": true
