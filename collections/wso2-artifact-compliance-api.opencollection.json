            "url": "https://apis.wso2.com/api/am/admin/v4/artifact-compliance/api/:apiId",
            "params": [
              {
                "name": "apiId",
                "value": "",
                "type": "path",
                "description": "**UUID** of the API.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
