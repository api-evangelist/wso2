            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.wso2.com/api/am/admin/v4/artifact-compliance/api",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum size of resource array to return.\n"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Starting point within the complete list of items qualified.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://localhost:9443/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves compliance of all API artifacts within the organization visible to logged-in user."
        },
        {
          "info": {
            "name": "Retrieves the summary of compliance of all API artifacts",
            "type": "http"
          },
